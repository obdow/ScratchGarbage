# Shared between the UI sprite and the Audio sprite (stage variables / lists).

const PPQ = 48            # ticks per beat
const BAR = 192           # ticks per bar (4/4)
const NTRK = 8
const DRUMKIT = 11        # instrument number of the drum kit
const NDRUM = 10
const COPIES = 6          # sound slots per melodic instrument
const DCOPIES = 3         # sound slots per drum
const MAXVOICES = 64

macro clamp(x, a, b) = min(max(x, a), b)

# ---- song (saved)
global bpm, swing, master, loop_on, loop_s, loop_e, song_mode
glist t_name, t_inst, t_vol, t_pan, t_mute, t_solo, t_tr, t_det, t_rel, t_cur
glist p_name, p_len, p_track, p_first, p_count
glist n_start, n_len, n_pitch, n_vel, n_sel
glist c_track, c_start, c_pat

# ---- static tables
glist inst_name, inst_root, drum_name

# ---- transport / audio state
global playing, song_pos, play_marker, seek_req, cur_pat, voices, gen, any_solo, metro_on
glist t_meter
glist q_trk, q_pitch, q_vel, q_dur, q_hold
glist held
glist save_code = "SAVE CODE"
